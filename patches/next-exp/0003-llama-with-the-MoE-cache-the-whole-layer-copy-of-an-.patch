From 8fb8986eb03e58ff45e16bef572e76f62ab1e7c1 Mon Sep 17 00:00:00 2001
From: Hector Raftakopoulos Gonzalez <hectoragofi@gmail.com>
Date: Tue, 24 Nov 2026 02:15:49 +0100
Subject: [PATCH 3/3] llama : with the MoE cache, the whole-layer copy of an
 Inkling 2 core layer reads its cached experts from the cache

---
 src/llama-context.cpp | 12 ++++++++++--
 1 file changed, 10 insertions(+), 2 deletions(-)

diff --git a/src/llama-context.cpp b/src/llama-context.cpp
index 8b9d9cfd2..579267224 100644
--- a/src/llama-context.cpp
+++ b/src/llama-context.cpp
@@ -3146,12 +3146,17 @@ bool llama_context::sched_copy_experts(ggml_backend_t backend, const ggml_tensor
 
     // Later loop passes can select different experts from the same device copy of a shared core layer, so those
     // are copied whole. The prelude and coda layers have one MUL_MAT_ID per weight and keep the partial copy.
+    // With the MoE cache, the whole copy of a core layer still takes its cached experts from device memory.
     // TODO: copy only the experts needed by each pass (see #32807 and #32809).
+    bool copy_all = false;
     if (lctx->model.arch == LLM_ARCH_INKLING2_LOOP) {
         const auto * lm = dynamic_cast<const llama_model_inkling2_loop *>(&lctx->model);
         int il = -1;
         if (!lm || sscanf(src->name, "blk.%d.", &il) != 1 || (il >= (int) lm->core_start && il < (int) lm->core_end)) {
-            return false;
+            if (!lm || !lctx->moe_cache || lctx->moe_cache->get_experts(src) == nullptr) {
+                return false;
+            }
+            copy_all = true;
         }
     }
 
@@ -3163,7 +3168,10 @@ bool llama_context::sched_copy_experts(ggml_backend_t backend, const ggml_tensor
     const int64_t n_expert    = src->ne[2];
     const size_t  expert_size = src->nb[2];
 
-    if (ids != st.ids || (int64_t) st.used.size() != n_expert) {
+    if (copy_all) {
+        st.used.assign(n_expert, true);
+        st.ids = nullptr;
+    } else if (ids != st.ids || (int64_t) st.used.size() != n_expert) {
         st.ids_data.resize(ggml_nbytes(ids)/sizeof(int32_t));
         ggml_backend_tensor_get_async(backend, ids, st.ids_data.data(), 0, ggml_nbytes(ids));
         ggml_backend_synchronize(backend);
-- 
