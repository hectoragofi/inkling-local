--- a/src/llama-moe-cache.cpp
+++ b/src/llama-moe-cache.cpp
@@ -348,6 +348,8 @@ struct llama_moe_cache::impl {
 
     // layers of the same device with the same expert tensor layout share the banks and the LRU of a group
     struct group {
+        bool    frozen  = false;          // LLAMA_MOE_CACHE_FREEZE: the slot and CPU maps no longer change
+        int64_t n_calls = 0;              // lookups with a CPU part since the cache was last unfrozen
         int32_t id;                       // device
