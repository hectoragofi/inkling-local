@@ -405,6 +407,11 @@ struct llama_moe_cache::impl {
     // LLAMA_MOE_CACHE_TRACE: the selected experts of each slot lookup, for a simulator of the cache
     FILE * trace = nullptr;
 
+    // LLAMA_MOE_CACHE_FREEZE=N: after N lookups of a group, its cached experts stay and all other experts are computed
+    // on the CPU, so a lookup no longer reads the selected experts back: the device does not wait for the host between
+    // the router and the cached experts, and the CPU part runs while the device computes them
+    int64_t freeze_after = 0;
+
     // slot maps in host memory
     ggml_context_ptr ctx_host;
     ggml_backend_buffer_ptr buf_host;
@@ -506,6 +513,9 @@ struct llama_moe_cache::impl {
 
         // within a device the budget is split by the size of the experts, so each group caches the same fraction of its experts
         cpu_share_q = (uint32_t) std::lround(cpu_share*65536.0f);
+        if (const char * s = getenv("LLAMA_MOE_CACHE_FREEZE"); s != nullptr && *s != '\0' && n_zero > 0) {
+            freeze_after = std::max<int64_t>(0, atoll(s));
+        }
         if (const char * path = getenv("LLAMA_MOE_CACHE_TRACE"); path != nullptr && *path != '\0') {
             trace = fopen(path, "wb");
             if (trace == nullptr) {
@@ -806,6 +816,16 @@ struct llama_moe_cache::impl {
 
         GGML_ASSERT(backend == devices[g.id].backend);
 
+        // called before the scheduler waits for the backend (no graph): only a frozen map, which does not change, is copied,
+        // ordered after the earlier work of the backend
+        if (graph == nullptr) {
+            if (!g.frozen || !has_cpu) {
+                return false;
+            }
+            ggml_backend_tensor_set_async(backend, dst, l.slot_map->data, 0, ggml_nbytes(l.slot_map));
+            return true;
+        }
+
         // the get_rows that looks up the slots of the selected experts
         const int n_nodes = ggml_graph_n_nodes(graph);
         const ggml_tensor * lookup = nullptr;
@@ -831,6 +851,48 @@ struct llama_moe_cache::impl {
 
         const int32_t n_used = (int32_t) sel->src[0]->ne[0];
 
+        if (freeze_after > 0) {
+            // a lookup without a CPU part must upload its misses
+            if (g.frozen && !has_cpu) {
+                g.frozen  = false;
+                g.n_calls = 0;
+            }
+            if (!g.frozen && has_cpu && ++g.n_calls > freeze_after) {
+                bool ok = true;
+                for (int32_t jl : g.layers) {
+                    ok = ok && layers[jl].cpu_map != nullptr;
+                }
+                if (ok) {
+                    size_t n_cached = 0;
+                    for (int32_t jl : g.layers) {
+                        layer & lj = layers[jl];
+                        const int32_t * cs = g.lru.canon[g.lru.phys[jl]].data();
+                        int32_t * sm = (int32_t *) lj.slot_map->data;
+                        int32_t * cm = (int32_t *) lj.cpu_map->data;
+                        lj.cpu_experts.clear();
+                        for (int32_t e = 0; e < g.lru.n_expert; ++e) {
+                            if (cs[e] < g.lru.n_slots) {
+                                sm[e] = cs[e];
+                                cm[e] = -1;
+                                n_cached++;
+                            } else {
+                                sm[e] = g.lru.n_slots + e % n_zero;
+                                cm[e] = e;
+                                lj.cpu_experts.push_back(e);
+                            }
+                        }
+                    }
+                    g.frozen = true;
+                    LLAMA_LOG_INFO("%s: MoE cache frozen after %lld lookups, %zu of %zu layer experts cached\n", __func__,
+                        (long long) freeze_after, n_cached, g.layers.size()*(size_t) g.lru.n_expert);
+                }
+            }
+            if (g.frozen) {
+                ggml_backend_tensor_set_async(backend, dst, l.slot_map->data, 0, ggml_nbytes(l.slot_map));
+                return true;
+            }
+        }
+
         ids.resize(ggml_nelements(sel));
         ggml_backend_tensor_get_async(backend, sel, ids.data(), 0, ggml_nbytes(sel));
         ggml_backend_synchronize(backend);
