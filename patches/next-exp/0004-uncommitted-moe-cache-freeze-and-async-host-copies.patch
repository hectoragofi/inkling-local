diff --git a/ggml/src/ggml-backend.cpp b/ggml/src/ggml-backend.cpp
index 8e175649b..ff0f5929a 100644
--- a/ggml/src/ggml-backend.cpp
+++ b/ggml/src/ggml-backend.cpp
@@ -1265,6 +1265,13 @@ struct ggml_backend_sched {
     int n_prefetched;
     int prefetch_split;     // the split that reads the prefetched inputs
     int prefetch_backend_id; // the backend that copies them
+
+    // results of CPU splits copied to a backend with async copies, ordered on that backend instead of waiting for it;
+    // a CPU split waits for these copies before it computes, as it may overwrite their source
+    ggml_backend_event_t host_copy_events [GGML_SCHED_MAX_BACKENDS]; // created on first use
+    bool                 host_copy_tried  [GGML_SCHED_MAX_BACKENDS];
+    bool                 host_copy_pending[GGML_SCHED_MAX_BACKENDS];
+    bool                 host_copy_split; // the current split copied such an input
 };
 
 #define hash_id(tensor) ggml_hash_find_or_insert(&sched->hash_set, tensor)
@@ -2134,6 +2141,33 @@ static void ggml_backend_sched_copy_input(ggml_backend_sched_t sched, struct ggm
         return;
     }
 
+    // a copy callback may first copy a host weight without the wait below (no graph), with copies ordered on the split backend
+    if (sched->callback_copy != NULL && ggml_backend_sched_is_host_weight(input) &&
+        sched->callback_copy(split_backend, input, input_cpy, NULL, sched->callback_copy_user_data)) {
+        return;
+    }
+
+    // a result of a CPU split, which computed synchronously: queue the copy on the split backend, after its earlier work
+    // that may still read the destination, without waiting for it
+    {
+        const struct ggml_tensor * base = input->view_src ? input->view_src : input;
+        if (split_backend->iface.set_tensor_async != NULL && input_cpy->buffer != NULL && !ggml_backend_buffer_is_host(input_cpy->buffer) &&
+            base->buffer != NULL && ggml_backend_buffer_is_host(base->buffer) &&
+            ggml_backend_buffer_get_usage(base->buffer) == GGML_BACKEND_BUFFER_USAGE_COMPUTE &&
+            ggml_backend_dev_type(ggml_backend_get_device(input_backend)) == GGML_BACKEND_DEVICE_TYPE_CPU &&
+            ggml_is_contiguous(input)) {
+            if (!sched->host_copy_tried[split_backend_id]) {
+                sched->host_copy_tried[split_backend_id]  = true;
+                sched->host_copy_events[split_backend_id] = ggml_backend_event_new(split_backend->device);
+            }
+            if (sched->host_copy_events[split_backend_id] != NULL) {
+                ggml_backend_tensor_set_async(split_backend, input_cpy, input->data, 0, ggml_nbytes(input));
+                sched->host_copy_split = true;
+                return;
+            }
+        }
+    }
+
     // wait for the split backend to finish using the input before overwriting it
     if (sched->events[split_backend_id][sched->cur_copy] != NULL) {
         ggml_backend_event_wait(split_backend, sched->events[split_backend_id][sched->cur_copy]);
@@ -2241,8 +2275,19 @@ static enum ggml_status ggml_backend_sched_compute_splits(ggml_backend_sched_t s
             }
         }
 
+        // a CPU split may overwrite the source of the queued copies of earlier CPU results
+        if (ggml_backend_dev_type(ggml_backend_get_device(split_backend)) == GGML_BACKEND_DEVICE_TYPE_CPU) {
+            for (int b = 0; b < sched->n_backends; b++) {
+                if (sched->host_copy_pending[b]) {
+                    ggml_backend_event_synchronize(sched->host_copy_events[b]);
+                    sched->host_copy_pending[b] = false;
+                }
+            }
+        }
+
         // copy the input tensors to the split backend
         // the weights in host memory are copied last, so that the copy callback can read the other inputs of the split
+        sched->host_copy_split = false;
         for (int input_id = 0; input_id < split->n_inputs; input_id++) {
             struct ggml_tensor * input = split->inputs[input_id];
             if (!ggml_backend_sched_is_host_weight(input) && sched->hv_tensor_requires_copy[hash_id(input)]) {
@@ -2258,6 +2303,10 @@ static enum ggml_status ggml_backend_sched_compute_splits(ggml_backend_sched_t s
                 ggml_backend_sched_copy_input(sched, split, input);
             }
         }
+        if (sched->host_copy_split) {
+            ggml_backend_event_record(sched->host_copy_events[split_backend_id], split_backend);
+            sched->host_copy_pending[split_backend_id] = true;
+        }
 
         if (!sched->callback_eval) {
             enum ggml_status ec = ggml_backend_graph_compute_async(split_backend, &split->graph);
@@ -2391,6 +2440,7 @@ void ggml_backend_sched_free(ggml_backend_sched_t sched) {
             ggml_backend_event_free(sched->events[b][c]);
         }
         ggml_backend_event_free(sched->prefetch_events[b]);
+        ggml_backend_event_free(sched->host_copy_events[b]);
     }
     ggml_gallocr_free(sched->galloc);
     ggml_free(sched->ctx);
