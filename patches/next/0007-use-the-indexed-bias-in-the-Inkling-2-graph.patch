+void llama_kv_cache_context::set_input_relative_pos(ggml_tensor * dst, const ggml_tensor * rows, const llama_ubatch * ubatch, uint32_t extent) const {
+    kv->set_input_relative_pos(dst, rows, ubatch, extent);
